{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": [
            "default",
            "!{projectRoot}/.eslintrc.json",
            "!{projectRoot}/eslint.config.cjs",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
            "!{projectRoot}/tsconfig.spec.json",
            "!{projectRoot}/jest.config.[jt]s",
            "!{projectRoot}/src/test-setup.[jt]s",
            "!{projectRoot}/test-setup.[jt]s"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/.github/workflows/ci.yml",
            "{workspaceRoot}/go.work"
        ]
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": {
                    "targetName": "typecheck"
                },
                "build": {
                    "targetName": "build",
                    "configName": "tsconfig.lib.json"
                }
            }
        },
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "lint"
            }
        },
        {
            "plugin": "@nx/jest/plugin",
            "options": {
                "targetName": "test"
            }
        }
    ],
    "targetDefaults": {
        "@nx/js:tsc": {
            "cache": false,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        },
        "@nx/esbuild:esbuild": {
            "cache": true,
            "dependsOn": ["^build"],
            "inputs": ["production", "^production"]
        }
    },
    "release": {
        "projectsRelationship": "independent",
        "version": {
            "adjustSemverBumpsForZeroMajorVersion": false,
            "versionActionsOptions": {
                "installIgnoreScripts": true
            }
        },
        "changelog": {
            "workspaceChangelog": false,
            "projectChangelogs": true,
            "automaticFromRef": true
        },
        "groups": {
            "sdk-typescript": {
                "projects": ["sdk-typescript"],
                "releaseTag": { "pattern": "sdk/typescript/v{version}" },
                "version": { "currentVersionResolver": "disk" }
            },
            "sdk-python": {
                "projects": ["sdk-python"],
                "releaseTag": { "pattern": "sdk/python/v{version}" },
                "version": {
                    "versionActions": "tools/release/version-actions.ts",
                    "versionActionsOptions": {
                        "file": "sdk/python/pyproject.toml"
                    },
                    "currentVersionResolver": "disk"
                }
            },
            "sdk-ruby": {
                "projects": ["sdk-ruby"],
                "releaseTag": { "pattern": "sdk/ruby/v{version}" },
                "version": {
                    "versionActions": "tools/release/version-actions.ts",
                    "versionActionsOptions": {
                        "file": "sdk/ruby/lib/buildkite/version.rb"
                    },
                    "currentVersionResolver": "disk"
                }
            },
            "sdk-csharp": {
                "projects": ["sdk-csharp"],
                "releaseTag": { "pattern": "sdk/csharp/v{version}" },
                "version": {
                    "versionActions": "tools/release/version-actions.ts",
                    "versionActionsOptions": {
                        "file": "sdk/csharp/src/Buildkite.Sdk/Buildkite.Sdk.csproj"
                    },
                    "currentVersionResolver": "disk"
                }
            },
            "sdk-go": {
                "projects": ["sdk-go"],
                "releaseTag": {
                    "pattern": "sdk/go/v{version}",
                    "checkAllBranchesWhen": true
                },
                "version": {
                    "versionActions": "tools/release/version-actions.ts",
                    "currentVersionResolver": "git-tag"
                }
            }
        }
    },
    "analytics": false,
    "neverConnectToCloud": true,
    "tui": {
        "enabled": false
    }
}
